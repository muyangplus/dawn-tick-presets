{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawn-tick.dev/schema/system-login.schema.json",
  "title": "DawnTick 教务系统登录入口（systems/<id>/login.json）",
  "description": "登录入口路径与提示。entryPath 只能是路径，必须 / 开头，且不能含协议或域名。",
  "type": "object",
  "required": ["entryPath", "hint"],
  "properties": {
    "entryPath": {
      "type": "string",
      "pattern": "^/",
      "description": "登录入口路径，必须以 / 开头，不能带协议或域名。"
    },
    "hint": { "type": "string", "minLength": 1, "description": "给用户的操作提示。" },
    "fields": {
      "type": "object",
      "description": "可选：登录表单字段名映射（字符串键值）。",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}

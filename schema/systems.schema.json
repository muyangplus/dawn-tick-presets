{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawn-tick.dev/schema/systems.schema.json",
  "title": "DawnTick 教务系统识别配置",
  "description": "单个教务系统的配置。仓库内每个文件描述一个系统，文件名必须与 id 一致。",
  "type": "object",
  "required": ["id", "name", "entryPath", "hint", "detect"],
  "properties": {
    "id": {
      "type": "string",
      "enum": ["jwglxt", "qzdatasource", "urp", "other"],
      "description": "系统 id，必须属于 SCHOOL_SYSTEM_IDS 且与文件名一致。"
    },
    "name": { "type": "string", "minLength": 1 },
    "entryPath": {
      "type": "string",
      "pattern": "^/",
      "description": "登录入口路径，必须以 / 开头，不能带域名。"
    },
    "hint": { "type": "string", "minLength": 1 },
    "detect": {
      "type": "object",
      "required": ["markers", "timetableTableIds", "timetableTableClasses", "gridCellIdPatterns"],
      "properties": {
        "markers": { "$ref": "#/$defs/stringArray" },
        "timetableTableIds": { "$ref": "#/$defs/stringArray" },
        "timetableTableClasses": { "$ref": "#/$defs/stringArray" },
        "gridCellIdPatterns": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "合法正则字符串，必须能被 new RegExp 编译。"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringArray": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawn-tick.dev/schema/timetable.schema.json",
  "title": "DawnTick 作息时间表（schools/<id>/timetable.json）",
  "description": "某个学校的作息时间表。id 可以与学校目录名不同（通用作息目录名为 _default、id 为 default）。",
  "type": "object",
  "required": ["id", "name", "periods"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "小写稳定标识（如 usts / default）。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "中文展示名，如「苏州科技大学」。"
    },
    "source": {
      "type": "string",
      "description": "来源说明，建议写明「学校教务处公告」「官网链接」或「用户提供截图」。"
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "description": "节次列表，必须按 periodNo 严格递增、从 1 起连续且不重叠。",
      "items": {
        "type": "object",
        "required": ["periodNo", "start", "end"],
        "properties": {
          "periodNo": { "type": "integer", "minimum": 1, "maximum": 24 },
          "start": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
          "end": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

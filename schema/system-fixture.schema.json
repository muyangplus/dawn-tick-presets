{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawn-tick.dev/schema/system-fixture.schema.json",
  "title": "DawnTick 适配器一致性用例（systems/<id>/fixtures/expected-events.json）",
  "description": "夹具里的期望事件。fixtures/ 至少要有 1 个页面样本与 1 个期望事件文件：有 parse.js 就必须有夹具，否则校验失败。",
  "type": "object",
  "required": ["id", "system", "adapter", "fixtures", "input", "expect"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "用例 id，建议与文件名一致。"
    },
    "system": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "该用例针对的教务系统 id，必须与所在目录名一致。"
    },
    "school": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "可选：页面样本来自哪所学校。"
    },
    "adapter": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*\\.js$",
      "description": "解析器文件名，固定为 parse.js（位于 systems/<id>/ 下）。"
    },
    "fixtures": {
      "type": "object",
      "required": ["page", "events"],
      "properties": {
        "page": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.html?$" },
        "events": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.json$" }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["url", "hints"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "hints": { "type": "object" }
      },
      "additionalProperties": false
    },
    "expect": {
      "type": "object",
      "required": ["minEvents"],
      "properties": {
        "minEvents": { "type": "integer", "minimum": 0 },
        "maxEvents": { "type": "integer", "minimum": 0 },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "dayOfWeek", "periodStart", "periodEnd"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "dayOfWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
              "periodStart": { "type": "integer", "minimum": 1, "maximum": 24 },
              "periodEnd": { "type": "integer", "minimum": 1, "maximum": 24 },
              "room": { "type": "string" },
              "teacher": { "type": "string" },
              "weeks": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

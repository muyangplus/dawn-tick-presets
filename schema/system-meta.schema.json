{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawn-tick.dev/schema/system-meta.schema.json",
  "title": "DawnTick 教务系统元数据（systems/<id>/meta.json）",
  "description": "描述一个教务系统：稳定 id、展示名、版本、别名与识别特征（detect）。登录入口在 login.json，解析器在 parse.js，夹具在 fixtures/。",
  "type": "object",
  "required": ["id", "name", "detect"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "系统 id，必须与目录名一致，且属于主项目约定的系统 id 集合。"
    },
    "name": { "type": "string", "minLength": 1, "description": "展示名，如「正方教务」。" },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "该系统配置 / 解析器自身的版本号（可省略）。"
    },
    "aliases": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1 },
      "description": "识别 / 搜索用别名。"
    },
    "detect": {
      "type": "object",
      "required": ["markers", "timetableTableIds", "timetableTableClasses", "gridCellIdPatterns"],
      "properties": {
        "markers": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1 },
          "description": "页面特征字符串（同时作为合法正则校验）。"
        },
        "timetableTableIds": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1 }
        },
        "timetableTableClasses": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1 }
        },
        "gridCellIdPatterns": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 },
          "description": "合法正则字符串，必须能被 new RegExp 编译。"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

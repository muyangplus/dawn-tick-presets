# 统一换行符，避免 Windows 检出的 CRLF 影响内容哈希与快照可复现性
* text=auto eol=lf

# 明确二进制（避免被当文本处理）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# 工作流与脚本必须 LF
*.yml text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
